{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "angular-ssr-transfer-cache-auth-demo": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": [
                "localhost"
              ]
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "off": {
              "outputPath": "dist/off",
              "fileReplacements": [
                {
                  "replace": "src/app/cache-options.ts",
                  "with": "src/app/modes/off.ts"
                }
              ],
              "outputHashing": "all"
            },
            "on": {
              "outputPath": "dist/on",
              "fileReplacements": [
                {
                  "replace": "src/app/cache-options.ts",
                  "with": "src/app/modes/on.ts"
                }
              ],
              "outputHashing": "all"
            },
            "filter": {
              "outputPath": "dist/filter",
              "fileReplacements": [
                {
                  "replace": "src/app/cache-options.ts",
                  "with": "src/app/modes/filter.ts"
                }
              ],
              "outputHashing": "all"
            },
            "filter-only": {
              "outputPath": "dist/filter-only",
              "fileReplacements": [
                {
                  "replace": "src/app/cache-options.ts",
                  "with": "src/app/modes/filter-only.ts"
                }
              ],
              "outputHashing": "all"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "angular-ssr-transfer-cache-auth-demo:build:production"
            },
            "development": {
              "buildTarget": "angular-ssr-transfer-cache-auth-demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}